@model Movie

@{
    ViewData["Title"] = "Add Movie";
}

<h1>Film Catalog</h1>
<h2>Welcome to Joel Hilton's Film Catalog! Enter a new film into the catalog using the boxes below:</h2>
<br />
<form method="post" asp-action="AddMovie">
    <label asp-for="CategoryId">Category:</label>
    <select asp-for="CategoryId" required>
        <option value="1">Miscellaneous</option>
        <option value="2">Drama</option>
        <option value="3">Television</option>
        <option value="4">Horror/Suspense</option>
        <option value="5">Comedy</option>
        <option value="6">Family</option>
        <option value="7">Action/Adventure</option>
        <option value="8">VHS</option>
    </select>
    <br />
    <label asp-for="Title">Title:</label>
    <input asp-for="Title" required/>
    <br />
    <label asp-for="Year">Year:</label>
    <input asp-for="Year" type="number" min="1888" required />
    <br />
    <label asp-for="Director">Director:</label>
    <input asp-for="Director"/>
    <br />
    <label asp-for="Rating">Rating:</label>
    <select asp-for="Rating">
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select>
    <br />
    <label asp-for="Edited">Edited?</label>
    <select asp-for ="Edited" required>
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <br />
    <label asp-for="LentTo">Lent to:</label>
    <input asp-for="LentTo" type="text" maxlength="25" />
    <br />
    <label asp-for="CopiedToPlex">Copied to Plex?</label>
    <select asp-for="CopiedToPlex" required>
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <br />
    <label asp-for="Notes">Notes:</label>
    <input asp-for="Notes" type="text" maxlength="25"/>
    <br />
    <button type="submit">Submit Movie</button>
</form>
<br />
<br />
