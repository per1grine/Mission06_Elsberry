@{
    ViewData["Title"] = "Movie List";
}

@model IEnumerable<Mission_6_Assignment.Models.Movie>

<h2>Movie Catalog:</h2>
<br />

<div class="container mt-4">
    <table class="table table-striped table-bordered table-hover">
        <thead class="thead-dark">
        <tr>
            <th>Category</th>
            <th>Title</th>
            <th>Year</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Edited?</th>
            <th>Lent To</th>
            <th>Notes</th>
            <th>Actions</th>
        </tr>
    </thead>

        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.CategoryId</td>
                <td>@x.Title</td>
                <td>@x.Year</td>
                <td>@x.Director</td>
                <td>@x.Rating</td>
                <td>@x.Edited</td>
                <td>@x.LentTo</td>
                <td>@x.CopiedToPlex</td>
                <td>@x.Notes</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@x.MovieId" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@x.MovieId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>}
        </tbody>
</table>
</div>

