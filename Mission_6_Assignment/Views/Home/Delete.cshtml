@model Mission_6_Assignment.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h1>Delete Movie</h1>
<h3>Are you sure you want to delete this movie?</h3>

<div>
    <p><strong>Title:</strong> @Model.Title</p>
    <p><strong>Category:</strong> @Model.CategoryId</p>
    <p><strong>Year:</strong> @Model.Year</p>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="MovieList" class="btn btn-secondary">Cancel</a>
</form>
